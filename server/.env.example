# Database
DATABASE_URL=jdbc:postgresql://localhost:5432/fireflow_db
DB_USER=fireflow
DB_PASSWORD=change-me-in-production

# JWT
JWT_SECRET=change-this-to-a-random-256-bit-secret-at-least-32-chars

# Environment (production => CORS fails closed without ALLOWED_ORIGINS)
ENVIRONMENT=production

# CORS: full origins, comma separated (required when ENVIRONMENT=production)
# ALLOWED_ORIGINS=https://app.example.com,http://localhost:3000

# Initial admin account (used only when the users table is empty)
ADMIN_INITIAL_USERNAME=admin
ADMIN_INITIAL_PASSWORD=change-me-Strong-Passw0rd

# TLS (activado cuando SSL_KEYSTORE esta definido)
# keytool -genkeypair -alias fireflow -keyalg RSA -keysize 4096 \
#   -keystore keystore/keystore.jks -validity 3650
# KEYSTORE_DIR=./keystore
# SERVER_PORT_SSL=8443
# SSL_KEYSTORE=/app/keystore/keystore.jks
# SSL_KEY_ALIAS=fireflow
# SSL_KEYSTORE_PASSWORD=change-me
# SSL_PRIVATE_KEY_PASSWORD=change-me
